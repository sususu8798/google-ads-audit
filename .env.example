# ===== 服务 =====
HOST=0.0.0.0
PORT=8011

# ===== 抓取限制（安全） =====
FETCH_TIMEOUT=15          # 单次请求超时（秒）
MAX_REDIRECTS=5           # 最大跳转次数
MAX_RESPONSE_BYTES=5242880  # 最大响应体（字节，默认 5MB）

# ===== 评分维度权重（总和应为 100） =====
W_ACCESSIBILITY=15        # 可访问性与技术稳定性
W_AD_RELEVANCE=15         # 广告—页面相关性
W_CONTENT=25              # 内容与产品信息
W_CONVERSION=10           # 询盘转化体验
W_MOBILE_PERF=10          # 移动端与性能
W_TRUST=25                # 信任与透明度

# ===== 优先级阈值（可配置，勿当作行业定律） =====
P1_MIN_COST=200           # 高费用且零转化判定 P1 的费用下限（按报表币种）
SMALL_SAMPLE_CLICKS=30    # 低于该点击数视为样本不足（P3 观察）
HIGH_CPA_FACTOR=2.0       # CPA 高于整体均值倍数时的提示阈值
